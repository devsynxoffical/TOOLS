# Database (Supabase PostgreSQL)
# Get this from Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Optional: force in-memory mock data (no database)
# USE_MOCK_DATA=true

# Session service (Phase 2 — cookie proxy for tool launch)
# Generate: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
SESSION_SERVICE_API_KEY=
SESSION_SERVICE_URL=http://localhost:4000
SESSION_SERVICE_PUBLIC_URL=http://localhost:4000
SESSION_SERVICE_PORT=4000

# Admin subdomain (optional — e.g. admin.yoursite.com)
# ADMIN_HOST=admin.yoursite.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.yoursite.com
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe payments (optional)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
