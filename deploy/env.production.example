# Copy to /var/www/groupbuy-tools/.env on the VPS
# Replace all CHANGE_ME values before going live.

# --- App ---
NODE_ENV=production
PORT=3000

# Public URL of the Next.js site (must match Nginx + SSL)
NEXTAUTH_URL=https://app.CHANGE_ME.com
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# --- Database (Supabase or Postgres on same VPS) ---
# Supabase on a VPS: use the session pooler (IPv4), not db.*.supabase.co (IPv6).
# Example (ap-northeast-1): postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Add connection_limit=1 when using Supabase pooler in session mode:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?connection_limit=1

# Do NOT use mock mode in production
# USE_MOCK_DATA=false

# --- Session service (internal) ---
# Next.js calls this on localhost — not exposed publicly except via Nginx
SESSION_SERVICE_URL=http://127.0.0.1:4000
SESSION_SERVICE_PORT=4000

# Public URL users hit for /go/ and /proxy/ (session subdomain)
SESSION_SERVICE_PUBLIC_URL=https://session.CHANGE_ME.com

# Shared secret between Next.js and session-service
SESSION_SERVICE_API_KEY=CHANGE_ME_long_random_string

# Encrypts tool account cookies at rest (same value on web + session service)
SESSION_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32
