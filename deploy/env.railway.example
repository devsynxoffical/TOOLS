# Railway → TOOLS → Variables → Raw Editor
# Hybrid: Next.js on Railway + session proxy on VPS (session.rankmora.io → 74.208.248.8)
#
# Fill SESSION_* / NEXTAUTH_SECRET / SMTP / Stripe from the VPS:
#   ssh root@74.208.248.8
#   grep -E '^(NEXTAUTH_SECRET|SESSION_|SMTP_|EMAIL_|STRIPE_|SECURITY_)' /var/www/groupbuy-tools/.env
#
# Do NOT use localhost or USE_MOCK_DATA=true here.

NODE_ENV=production

# Public site (no trailing slash)
NEXTAUTH_URL=https://rankmora.io
NEXT_PUBLIC_APP_URL=https://rankmora.io
# Optional if you use www + apex shared cookies:
# NEXTAUTH_COOKIE_DOMAIN=.rankmora.io

NEXTAUTH_SECRET=CHANGE_ME_FROM_VPS

# Railway Postgres (same project). Service name must match Variables UI.
DATABASE_URL=${{Postgres-CSxL.DATABASE_URL}}

# Session proxy lives on the VPS — never http://localhost:4000 on Railway
SESSION_SERVICE_URL=https://session.rankmora.io
SESSION_SERVICE_PUBLIC_URL=https://session.rankmora.io
SESSION_SERVICE_API_KEY=CHANGE_ME_FROM_VPS
SESSION_ENCRYPTION_KEY=CHANGE_ME_FROM_VPS
# Optional tool subdomains (DNS *.tools.rankmora.io → VPS):
# SESSION_TOOLS_BASE_DOMAIN=tools.rankmora.io
# SESSION_COOKIE_DOMAIN=.tools.rankmora.io

# Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=CHANGE_ME_FROM_VPS
EMAIL_FROM=noreply@rankmora.io
EMAIL_FROM_NAME=Rankmora
SECURITY_ALERT_EMAIL=rankmoraoffical@gmail.com

# Stripe (use live keys in real production)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
# STRIPE_WEBHOOK_SECRET=CHANGE_ME

# Explicitly off
USE_MOCK_DATA=false
