# Option A — subdomain (preferred once DNS exists)
# DNS: A record cloud.rankmora.io → VPS IP
# Then: certbot --nginx -d cloud.rankmora.io
#
# CLOUD_BROWSER_PUBLIC_URL=https://cloud.rankmora.io
# CLOUD_BROWSER_BIND_HOST=127.0.0.1

server {
  listen 80;
  listen [::]:80;
  server_name cloud.rankmora.io;

  location / {
    proxy_pass http://127.0.0.1:4100;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }
}

# Option B — path on existing HTTPS site (no new DNS; keep 4100 localhost-only)
# Paste the location block into the SSL server { ... } for rankmora.io / www.rankmora.io
# (same place other location / blocks live).
#
# CLOUD_BROWSER_PUBLIC_URL=https://rankmora.io/cloud-browser
# CLOUD_BROWSER_BIND_HOST=127.0.0.1

