{
  "manifest_version": 3,
  "name": "Rankmora Tool Launcher",
  "version": "1.3.0",
  "description": "Opens Rankmora group-buy tools on their real domain with your authorized session.",
  "permissions": ["cookies", "tabs", "storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://*.canva.com/*",
    "https://canva.com/*",
    "https://*.chatgpt.com/*",
    "https://chatgpt.com/*",
    "https://*.openai.com/*",
    "https://openai.com/*",
    "https://*.claude.ai/*",
    "https://claude.ai/*",
    "https://*.anthropic.com/*",
    "https://anthropic.com/*",
    "https://*.grammarly.com/*",
    "https://grammarly.com/*",
    "https://*.grammarly.io/*",
    "https://*.quillbot.com/*",
    "https://quillbot.com/*",
    "https://rankmora.io/*",
    "https://*.rankmora.io/*",
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shield_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://rankmora.io/*",
        "https://*.rankmora.io/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.canva.com/*",
        "https://canva.com/*",
        "https://*.chatgpt.com/*",
        "https://chatgpt.com/*",
        "https://*.openai.com/*",
        "https://openai.com/*",
        "https://*.claude.ai/*",
        "https://claude.ai/*",
        "https://*.anthropic.com/*",
        "https://anthropic.com/*",
        "https://*.grammarly.com/*",
        "https://grammarly.com/*",
        "https://*.grammarly.io/*",
        "https://*.quillbot.com/*",
        "https://quillbot.com/*"
      ],
      "js": ["shield.js"],
      "css": ["shield.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Rankmora Tool Launcher",
    "default_popup": "popup.html"
  }
}
